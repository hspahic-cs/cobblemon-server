+  /**
+   * cobblemon-server pre-check patch (§2.46): fetch the account's armed-run
+   * credits from the reward bridge's courtesy endpoint.
+   * @returns The credit count, or `null` if it could not be determined
+   * (network failure, unauthenticated, endpoint missing). Callers must treat
+   * `null` as "let the run proceed" — the save-time 402 is the enforcement.
+   */
+  public async getBridgeArmedCredits(): Promise<number | null> {
+    try {
+      const response = await this.doGet("/bridge/armed");
+      if (response.status === 402) {
+        return 0;
+      }
+      if (!response.ok) {
+        return null;
+      }
+      const json = (await response.json()) as { credits?: number };
+      return typeof json.credits === "number" ? json.credits : null;
+    } catch (err) {
+      console.warn("Could not check armed-run credits!", err);
+      return null;
+    }
+  }
