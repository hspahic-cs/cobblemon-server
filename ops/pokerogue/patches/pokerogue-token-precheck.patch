+// cobblemon-server token-login patch (§2.46): the shrine's tokenized entry link
+// opens the page as <origin>/#pt=<URL-encoded session token>. Seed the session
+// cookie from the fragment BEFORE any session check can run, then strip the
+// token from the URL and history; the normal boot then finds the cookie and the
+// player lands on the title screen already logged in.
+const entryTokenMatch = /^#pt=(.+)$/.exec(window.location.hash);
+if (entryTokenMatch) {
+  setCookie(SESSION_ID_COOKIE_NAME, decodeURIComponent(entryTokenMatch[1]));
+  window.history.replaceState(null, "", window.location.pathname + window.location.search);
+}
