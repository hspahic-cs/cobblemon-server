 func handleAccountRegister(w http.ResponseWriter, r *http.Request) {
+	// cobblemon-server patch (§2.46 follow-up): accounts are minted only by the MC
+	// bridge — registration requires the shared secret. Fail-closed when unset.
+	if BridgeTokenSecret == "" {
+		http.Error(w, "account registration is disabled", http.StatusServiceUnavailable)
+		return
+	}
+	provided := sha256.Sum256([]byte(r.Header.Get("X-Bridge-Secret")))
+	expected := sha256.Sum256([]byte(BridgeTokenSecret))
+	if subtle.ConstantTimeCompare(provided[:], expected[:]) != 1 {
+		http.Error(w, "accounts are created in-game", http.StatusForbidden)
+		return
+	}
+
