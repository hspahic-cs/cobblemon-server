+// cobblemon-server glimpse patch (§2.49): the account's activated species — national dex
+// number -> whitelist row creation time (unix seconds). createdAt reconstructs the
+// serve-time mask on merge (the MC bridge only ever INSERT IGNOREs, so it is stable).
+func (s *store) ReadBridgeDexWhitelist(uuid []byte) (map[int]int64, error) {
+	rows, err := handle.Query("SELECT speciesId, UNIX_TIMESTAMP(createdAt) FROM bridgeDexWhitelist WHERE uuid = ?", uuid)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+
+	out := make(map[int]int64)
+	for rows.Next() {
+		var id int
+		var createdAt int64
+		if err := rows.Scan(&id, &createdAt); err != nil {
+			return nil, err
+		}
+		out[id] = createdAt
+	}
+	return out, rows.Err()
+}
