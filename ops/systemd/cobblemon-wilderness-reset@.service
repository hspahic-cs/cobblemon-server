# Daily maintenance pipeline for one cobblemon environment.
# Templated by env: `cobblemon-wilderness-reset@dev` / `cobblemon-wilderness-reset@prod`
# (the %i instance name is passed to the driver as <dev|prod>).
#
# Paired with cobblemon-wilderness-reset@.timer, which fires this at 05:30 America/New_York.
# The pipeline snapshots the world, then ON A RESET DAY arms the border wipe, then restarts — in
# that order (backup strictly before wipe). Runs as the service user (sysadmin); only the restart
# escalates via NOPASSWD sudo. Both wilderness-maintenance.sh and world-snapshot.sh must be
# deployed (see ops/systemd/README.md). Do NOT enable the .service directly — enable the .timer.
[Unit]
Description=Daily backup + (periodic) wilderness reset for cobblemon-%i
# Don't fire if the target server unit isn't installed.
After=cobblemon-%i.service

[Service]
Type=oneshot
User=sysadmin
# Adjust if you install the driver elsewhere (see README). Cadence knobs (override via a drop-in):
#   RESET_PERIOD_DAYS (default 14), RESET_ANCHOR_DATE (default 2026-01-01).
ExecStart=/usr/local/bin/wilderness-maintenance.sh %i
